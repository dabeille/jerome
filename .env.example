# Copy to .env, fill in, then:  chmod 600 .env
# NEVER commit .env. Paper and live keys are separate on purpose —
# don't add live keys until Phase 2.

BOT_MODE=paper              # backtest | paper | approve | live

ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET=

# Leave blank until Phase 2 (live trading):
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET=

# Free-tier data keys:
FINNHUB_KEY=
ALPHA_VANTAGE_KEY=

# LLM analyst:
ANTHROPIC_API_KEY=
