# Copy to .env, fill in, then:  chmod 600 .env
# NEVER commit .env. Paper and live keys are separate on purpose —
# don't add live keys until Phase 2.

BOT_MODE=paper              # backtest | paper | approve | live

ALPACA_PAPER_KEY_ID=my_paper_id
ALPACA_PAPER_SECRET=my_paper_secret

# Leave blank until Phase 2 (live trading):
ALPACA_LIVE_KEY_ID=my_paper_id
ALPACA_LIVE_SECRET=my_paper_secret

# Free-tier data keys:
FINNHUB_KEY=my_finn_key
ALPHA_VANTAGE_KEY=my_alpha_key

# LLM analyst:
ANTHROPIC_API_KEY=my_ant_key

# Signal modules the daily loop runs (comma-separated). Default is both.
# Phase-1 setting from 2026-08-16: meanrev only. Blended, momentum's ~168-day
# holds occupy the open slots and meanrev gets roughly one trade a week, so the
# retuned geometry can't be observed. Revert to both (or drop the line) once
# momentum has a time-stop.
ENABLED_STRATEGIES=meanrev

# Failure alerts (Phase 1, Resend email). Leave RESEND_API_KEY blank to
# disable alerting (the bot logs a warning and no-ops instead of crashing).
# ALERT_EMAIL_FROM defaults to Resend's shared onboarding@resend.dev sender,
# which delivers to the account owner without any domain setup.
RESEND_API_KEY=
ALERT_EMAIL_TO=you@example.com
# ALERT_EMAIL_FROM=onboarding@resend.dev
